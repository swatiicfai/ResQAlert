# ResQAlert Environment Variables

# MongoDB Atlas Connection URI (optional - falls back to local JSON store if omitted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resqalert?retryWrites=true&w=majority

# Twilio Programmable SMS Credentials (optional - simulation mode works without API keys)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+18005557377

# Auth0 Authentication (optional - role switcher available in UI)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id_here
